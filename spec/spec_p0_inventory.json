{
  "spec": "§IN",
  "version": "0.40.0",
  "fingerprint_prefix": "0xD000",
  "types": [
    {"name": "Inventory", "kind": "list", "element": "nat"},
    {"name": "Item", "kind": "alias", "target": "nat"},
    {"name": "Qty", "kind": "alias", "target": "nat"},
    {"name": "Q", "kind": "alias", "target": "float"}
  ],
  "operations": [
    {
      "name": "inventory_new",
      "fingerprint": "0xD001",
      "signature": {"params": ["Qty", "Qty"], "returns": "Inventory"},
      "definition": {
        "kind": "lambda",
        "params": ["a", "b"],
        "body": {"list": ["a", "b"]}
      },
      "preconditions": [
        {"expr": "a >= 0 and b >= 0", "error": "TypeError", "description": "opening stock levels must be >= 0 (开仓库存不可为负)"}
      ],
      "laws": [
        {"forall": ["a", "b"], "predicate": "0 <= index(inventory_new(a, b), 0) && 0 <= index(inventory_new(a, b), 1)", "description": "stock levels >= 0"},
        {"forall": ["a", "b"], "predicate": "index(inventory_new(a, b), 0) == a", "description": "qtyA preserved"},
        {"forall": ["a", "b"], "predicate": "index(inventory_new(a, b), 1) == b", "description": "qtyB preserved"}
      ],
      "tests": [
        {"input": [10, 20], "output": [10, 20], "description": "open inventory with A=10, B=20"},
        {"input": [0, 0], "output": [0, 0], "description": "empty inventory allowed"},
        {"input": [-5, 10], "output": null, "error": "TypeError", "description": "negative opening stock rejected"}
      ]
    },
    {
      "name": "receive_stock",
      "fingerprint": "0xD002",
      "signature": {"params": ["Inventory", "Item", "Qty"], "returns": "Inventory"},
      "definition": {
        "kind": "lambda",
        "params": ["i", "x", "q"],
        "body": {"if": {"fn": "eq", "args": ["x", 0]},
          "then": {"list": [
            {"fn": "add", "args": [{"fn": "index", "args": ["i", 0]}, "q"]},
            {"fn": "index", "args": ["i", 1]}]},
          "else": {"list": [
            {"fn": "index", "args": ["i", 0]},
            {"fn": "add", "args": [{"fn": "index", "args": ["i", 1]}, "q"]}]}}
      },
      "preconditions": [
        {"expr": "x == 0 or x == 1", "error": "UnknownItem", "description": "item must be 0 (A) or 1 (B)"}
      ],
      "laws": [
        {"forall": ["i", "x", "q"], "predicate": "index(receive_stock(i, x, q), x + 1) == index(i, x + 1) + q", "description": "additive: received stock is summed (守恒)"},
        {"forall": ["i", "x", "q"], "predicate": "0 <= index(receive_stock(i, x, q), x + 1)", "description": "level never negative"}
      ],
      "tests": [
        {"input": [{"op": "inventory_new", "args": [10, 20]}, 0, 5], "output": [15, 20], "description": "receive 5 of A"},
        {"input": [{"op": "inventory_new", "args": [10, 20]}, 1, 3], "output": [10, 23], "description": "receive 3 of B"},
        {"input": [{"op": "inventory_new", "args": [10, 20]}, 2, 5], "output": null, "error": "UnknownItem", "description": "unknown item 2 rejected"}
      ]
    },
    {
      "name": "ship_stock",
      "fingerprint": "0xD003",
      "signature": {"params": ["Inventory", "Item", "Qty"], "returns": "Inventory"},
      "definition": {
        "kind": "lambda",
        "params": ["i", "x", "q"],
        "body": {"if": {"fn": "eq", "args": ["x", 0]},
          "then": {"list": [
            {"fn": "sub", "args": [{"fn": "index", "args": ["i", 0]}, "q"]},
            {"fn": "index", "args": ["i", 1]}]},
          "else": {"list": [
            {"fn": "index", "args": ["i", 0]},
            {"fn": "sub", "args": [{"fn": "index", "args": ["i", 1]}, "q"]}]}}
      },
      "preconditions": [
        {"expr": "x == 0 or x == 1", "error": "UnknownItem", "description": "item must be 0 (A) or 1 (B)"},
        {"expr": "(x == 0 and index(i, 0) >= q) or (x == 1 and index(i, 1) >= q)", "error": "InsufficientStock", "description": "cannot ship more than held (禁止负库存)"}
      ],
      "laws": [
        {"forall": ["i", "x", "q"], "predicate": "index(i, x + 1) >= q => index(ship_stock(i, x, q), x + 1) == index(i, x + 1) - q", "description": "decrement: shipped stock subtracts"},
        {"forall": ["i", "x", "q"], "predicate": "index(i, x + 1) >= q => 0 <= index(ship_stock(i, x, q), x + 1)", "description": "no naked shorts: level never negative"},
        {"forall": ["i", "x", "q"], "predicate": "index(i, x + 1) < q => raises(ship_stock(i, x, q), InsufficientStock)", "description": "no negative stock (禁止负库存)"}
      ],
      "tests": [
        {"input": [{"op": "inventory_new", "args": [10, 20]}, 0, 4], "output": [6, 20], "description": "ship 4 of A"},
        {"input": [{"op": "inventory_new", "args": [10, 20]}, 1, 20], "output": [10, 0], "description": "ship all 20 of B"},
        {"input": [{"op": "inventory_new", "args": [10, 20]}, 0, 11], "output": null, "error": "InsufficientStock", "description": "ship more than held rejected"},
        {"input": [{"op": "inventory_new", "args": [10, 20]}, 2, 5], "output": null, "error": "UnknownItem", "description": "unknown item 2 rejected"}
      ]
    },
    {
      "name": "stock_level",
      "fingerprint": "0xD004",
      "signature": {"params": ["Inventory", "Item"], "returns": "nat"},
      "definition": {
        "kind": "lambda",
        "params": ["i", "x"],
        "body": {"if": {"fn": "eq", "args": ["x", 0]},
          "then": {"fn": "index", "args": ["i", 0]},
          "else": {"fn": "index", "args": ["i", 1]}}
      },
      "preconditions": [],
      "laws": [
        {"forall": ["i", "x"], "predicate": "0 <= stock_level(i, x)", "description": "level never negative"},
        {"forall": ["i"], "predicate": "stock_level(i, 0) + stock_level(i, 1) == index(i, 0) + index(i, 1)", "description": "total stock preserved"}
      ],
      "tests": [
        {"input": [{"op": "inventory_new", "args": [10, 20]}, 0], "output": 10, "description": "level of A is 10"},
        {"input": [{"op": "inventory_new", "args": [10, 20]}, 1], "output": 20, "description": "level of B is 20"},
        {"input": [5, 0], "output": null, "error": "TypeError", "description": "non-inventory input rejected"}
      ]
    },
    {
      "name": "fill_rate",
      "fingerprint": "0xD005",
      "signature": {"params": ["Qty", "Qty"], "returns": "Q"},
      "definition": {
        "kind": "lambda",
        "params": ["s", "d"],
        "body": {"fn": "div", "args": ["s", "d"]}
      },
      "preconditions": [
        {"expr": "d > 0", "error": "DivByZero", "description": "demanded must be > 0 (零需求拒绝)"}
      ],
      "laws": [
        {"forall": ["s", "d"], "predicate": "d > 0 => 0 <= fill_rate(s, d) && fill_rate(s, d) <= 1", "description": "rate bounded 0..1 (s <= d by construction)"},
        {"forall": ["s", "d"], "predicate": "d == 0 => raises(fill_rate(s, d), DivByZero)", "description": "zero demand rejected"}
      ],
      "tests": [
        {"input": [6, 10], "output": 0.6, "description": "6 shipped / 10 demanded = 0.6"},
        {"input": [10, 10], "output": 1.0, "description": "full fill rate = 1.0"},
        {"input": [6, 0], "output": null, "error": "DivByZero", "description": "zero demand rejected"}
      ]
    }
  ]
}
