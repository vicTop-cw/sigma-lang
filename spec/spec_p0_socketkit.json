{
  "spec": "§SK",
  "version": "0.30.0",
  "fingerprint_prefix": "0xF000",
  "types": [
    {"name": "Author", "kind": "alias", "target": "nat"},
    {"name": "Hunter", "kind": "alias", "target": "nat"},
    {"name": "Bounty", "kind": "alias", "target": "nat"},
    {"name": "Status", "kind": "enum", "values": [
      {"name": "open", "value": 0},
      {"name": "in_progress", "value": 1},
      {"name": "pending_review", "value": 2},
      {"name": "completed", "value": 3}
    ]},
    {"name": "Decision", "kind": "enum", "values": [
      {"name": "accept", "value": 1},
      {"name": "reject", "value": 0}
    ]},
    {"name": "Task", "kind": "list", "element": "nat"},
    {"name": "Opinion", "kind": "list", "element": "nat"},
    {"name": "Action", "kind": "list", "element": "nat"},
    {"name": "Event", "kind": "list", "element": "nat"},
    {"name": "Points", "kind": "list", "element": "nat"},
    {"name": "Credit", "kind": "alias", "target": "nat"},
    {"name": "Quota", "kind": "list", "element": "nat"},
    {"name": "Badge", "kind": "list", "element": "nat"},
    {"name": "Team", "kind": "list", "element": "nat"}
  ],
  "operations": [
    {
      "name": "task_create",
      "fingerprint": "0xF001",
      "signature": {"params": ["nat", "nat"], "returns": "Task"},
      "definition": {
        "kind": "lambda",
        "params": ["a", "b"],
        "body": {"list": ["a", "b", 0, 0]}
      },
      "preconditions": [
        {"expr": "b >= 0", "error": "BountyErr", "description": "bounty must be >= 0 (赏金可为 0)"}
      ],
      "laws": [
        {"forall": ["a", "b"], "predicate": "0 <= index(task_create(a, b), 1)", "description": "bounty >= 0 (赏金可为 0)"},
        {"forall": ["a", "b"], "predicate": "index(task_create(a, b), 2) == 0", "description": "freshly created task is open"},
        {"forall": ["a", "b"], "predicate": "index(task_create(a, b), 3) == 0", "description": "freshly created task is unclaimed"}
      ],
      "tests": [
        {"input": [7, 100], "output": [7, 100, 0, 0], "description": "basic create: [author, bounty, open, unclaimed]"},
        {"input": [2, 0], "output": [2, 0, 0, 0], "description": "zero bounty allowed"},
        {"input": [1, -5], "output": null, "error": "BountyErr", "description": "negative bounty rejected"}
      ]
    },
    {
      "name": "review_merge",
      "fingerprint": "0xF002",
      "signature": {"params": ["List<Opinion>"], "returns": "Decision"},
      "definition": {
        "kind": "lambda",
        "params": ["os"],
        "body": {"if": {"fn": "ge", "args": [{"fn": "weighted_accept", "args": ["os"]}, {"fn": "weighted_reject", "args": ["os"]}]}, "then": 1, "else": 0}
      },
      "preconditions": [],
      "laws": [
        {"forall": ["o"], "predicate": "review_merge(o) == 0 || review_merge(o) == 1", "description": "decision is binary (0=reject, 1=accept)"},
        {"forall": ["o"], "predicate": "review_merge(o) == review_merge(reverse(o))", "description": "order-independent: weighted sums commute"}
      ],
      "tests": [
        {"input": [[[1, 1, 3], [2, 1, 2]]], "output": 1, "description": "weighted_accept 3+2=5 >= weighted_reject 0"},
        {"input": [[[1, 0, 5], [2, 1, 2]]], "output": 0, "description": "weighted_reject 5 > weighted_accept 2"},
        {"input": [3], "output": null, "error": "TypeError", "description": "non-list input rejected"}
      ]
    },
    {
      "name": "contribution_score",
      "fingerprint": "0xF003",
      "signature": {"params": ["List<Action>"], "returns": "nat"},
      "definition": {
        "kind": "lambda",
        "params": ["a"],
        "body": {"fn": "max", "args": [0, {"fn": "fold_add", "args": ["a"]}]}
      },
      "preconditions": [],
      "laws": [
        {"forall": ["a"], "predicate": "0 <= contribution_score(a)", "description": "points never negative (floored at 0)"},
        {"forall": ["a"], "predicate": "contribution_score(a) == contribution_score(append(a, [0, 0, 0]))", "description": "zero-delta action is neutral"}
      ],
      "tests": [
        {"input": [[[1, 1, 3], [2, 2, 4]]], "output": 7, "description": "sum of deltas 3+4=7"},
        {"input": [[[1, 1, -5], [2, 2, 3]]], "output": 0, "description": "-5+3=-2 floored at 0 (负数不参与分红)"},
        {"input": [5], "output": null, "error": "TypeError", "description": "non-list input rejected"}
      ]
    },
    {
      "name": "accept_task",
      "fingerprint": "0xF004",
      "signature": {"params": ["Task", "nat"], "returns": "Task"},
      "definition": {
        "kind": "lambda",
        "params": ["t", "h"],
        "body": {"list": [{"fn": "index", "args": ["t", 0]}, {"fn": "index", "args": ["t", 1]}, 1, "h"]}
      },
      "preconditions": [
        {"expr": "index(t, 2) == 0", "error": "StateError", "description": "task must be open (status 0) to claim"}
      ],
      "laws": [
        {"forall": ["t", "h"], "predicate": "index(t, 2) == 0 => index(accept_task(t, h), 2) == 1", "description": "claim moves task to in_progress"},
        {"forall": ["t", "h"], "predicate": "index(t, 2) == 0 => index(accept_task(t, h), 3) == h", "description": "hunter recorded"},
        {"forall": ["t", "h"], "predicate": "index(t, 2) in {0,1,2} => index(accept_task(t, h), 2) >= index(t, 2)", "description": "INV-1: status monotonic (0 -> 1)"},
        {"forall": ["t", "h"], "predicate": "index(t, 2) == 3 => raises(accept_task(t, h), StateError)", "description": "INV-2: completed task cannot be changed"},
        {"forall": ["t", "h"], "predicate": "index(accept_task(t, h), 1) == index(t, 1)", "description": "INV-3: bounty conserved"}
      ],
      "tests": [
        {"input": [{"op": "task_create", "args": [7, 100]}, 3], "output": [7, 100, 1, 3], "description": "hunter 3 claims open task"},
        {"input": [{"op": "task_create", "args": [2, 0]}, 9], "output": [2, 0, 1, 9], "description": "hunter 9 claims zero-bounty task"},
        {"input": [[7, 100, 1, 3], 5], "output": null, "error": "StateError", "description": "in_progress task cannot be claimed again"}
      ]
    },
    {
      "name": "task_submit",
      "fingerprint": "0xF005",
      "signature": {"params": ["Task"], "returns": "Task"},
      "definition": {
        "kind": "lambda",
        "params": ["t"],
        "body": {"list": [{"fn": "index", "args": ["t", 0]}, {"fn": "index", "args": ["t", 1]}, 2, {"fn": "index", "args": ["t", 3]}]}
      },
      "preconditions": [
        {"expr": "index(t, 2) == 1", "error": "StateError", "description": "task must be in_progress (status 1) to submit"}
      ],
      "laws": [
        {"forall": ["t"], "predicate": "index(t, 2) == 1 => index(task_submit(t), 2) == 2", "description": "submit moves task to pending_review"},
        {"forall": ["t"], "predicate": "index(t, 2) == 1 => index(task_submit(t), 3) == index(t, 3)", "description": "hunter preserved"},
        {"forall": ["t"], "predicate": "index(t, 2) in {0,1,2} => index(task_submit(t), 2) >= index(t, 2)", "description": "INV-1: status monotonic (1 -> 2)"},
        {"forall": ["t"], "predicate": "index(t, 2) == 3 => raises(task_submit(t), StateError)", "description": "INV-2: completed task cannot be changed"},
        {"forall": ["t"], "predicate": "index(task_submit(t), 1) == index(t, 1)", "description": "INV-3: bounty conserved"}
      ],
      "tests": [
        {"input": [{"op": "accept_task", "args": [{"op": "task_create", "args": [5, 50]}, 3]}], "output": [5, 50, 2, 3], "description": "submit claimed task"},
        {"input": [{"op": "accept_task", "args": [{"op": "task_create", "args": [2, 0]}, 9]}], "output": [2, 0, 2, 9], "description": "submit zero-bounty claimed task"},
        {"input": [{"op": "task_create", "args": [5, 50]}], "output": null, "error": "StateError", "description": "open task cannot be submitted"}
      ]
    },
    {
      "name": "task_accept",
      "fingerprint": "0xF006",
      "signature": {"params": ["Task", "nat"], "returns": "Task"},
      "definition": {
        "kind": "lambda",
        "params": ["t", "c"],
        "body": {"list": [{"fn": "index", "args": ["t", 0]}, {"fn": "index", "args": ["t", 1]}, 3, {"fn": "index", "args": ["t", 3]}]}
      },
      "preconditions": [
        {"expr": "index(t, 2) == 2", "error": "StateError", "description": "task must be pending_review (status 2) to accept"},
        {"expr": "c == index(t, 0)", "error": "AuthError", "description": "only the author (受茬人本人) may accept own task (INV-4)"}
      ],
      "laws": [
        {"forall": ["t", "c"], "predicate": "index(t, 2) == 2 => index(task_accept(t, c), 2) == 3", "description": "accept moves task to completed"},
        {"forall": ["t", "c"], "predicate": "index(t, 2) == 2 => index(task_accept(t, c), 3) == index(t, 3)", "description": "hunter preserved"},
        {"forall": ["t", "c"], "predicate": "index(t, 2) == 2 && c != index(t, 0) => raises(task_accept(t, c), AuthError)", "description": "INV-4: only author may accept (c == author)"},
        {"forall": ["t", "c"], "predicate": "index(t, 2) in {0,1,2} => index(task_accept(t, c), 2) >= index(t, 2)", "description": "INV-1: status monotonic (2 -> 3)"},
        {"forall": ["t", "c"], "predicate": "index(t, 2) == 3 => raises(task_accept(t, c), StateError)", "description": "INV-2: completed task cannot be changed"},
        {"forall": ["t", "c"], "predicate": "index(task_accept(t, c), 1) == index(t, 1)", "description": "INV-3: bounty conserved"}
      ],
      "tests": [
        {"input": [{"op": "task_submit", "args": [{"op": "accept_task", "args": [{"op": "task_create", "args": [5, 50]}, 3]}]}, 5], "output": [5, 50, 3, 3], "description": "author 5 accepts own task"},
        {"input": [{"op": "task_submit", "args": [{"op": "accept_task", "args": [{"op": "task_create", "args": [2, 0]}, 9]}]}, 2], "output": [2, 0, 3, 9], "description": "author 2 accepts own task"},
        {"input": [{"op": "task_submit", "args": [{"op": "accept_task", "args": [{"op": "task_create", "args": [5, 50]}, 3]}]}, 9], "output": null, "error": "AuthError", "description": "non-author caller rejected (INV-4)"},
        {"input": [{"op": "task_create", "args": [5, 50]}, 5], "output": null, "error": "StateError", "description": "open task cannot be accepted"}
      ]
    },
