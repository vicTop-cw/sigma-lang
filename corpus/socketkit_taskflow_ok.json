{
  "module": "socketkit_taskflow_ok",
  "expected_verdict": "PASS",
  "spec": "spec_p0_socketkit.json",
  "tests": [
    {"op": "task_create", "args": [7, 100], "expect": [7, 100, 0, 0]},
    {"op": "task_create", "args": [2, 0], "expect": [2, 0, 0, 0]},
    {"op": "task_create", "args": [1, -5], "error": "BountyErr"},
    {"sequence": [
      {"op": "task_create", "args": [7, 100], "expect": [7, 100, 0, 0]},
      {"op": "accept_task", "args": ["$_", 3], "expect": [7, 100, 1, 3]}
    ]},
    {"sequence": [
      {"op": "task_create", "args": [2, 0], "expect": [2, 0, 0, 0]},
      {"op": "accept_task", "args": ["$_", 9], "expect": [2, 0, 1, 9]}
    ]},
    {"op": "accept_task", "args": [[7, 100, 1, 3], 5], "error": "StateError"},
    {"sequence": [
      {"op": "task_create", "args": [5, 50], "expect": [5, 50, 0, 0]},
      {"op": "accept_task", "args": ["$_", 3], "expect": [5, 50, 1, 3]},
      {"op": "task_submit", "args": ["$_"], "expect": [5, 50, 2, 3]}
    ]},
    {"sequence": [
      {"op": "task_create", "args": [2, 0], "expect": [2, 0, 0, 0]},
      {"op": "accept_task", "args": ["$_", 9], "expect": [2, 0, 1, 9]},
      {"op": "task_submit", "args": ["$_"], "expect": [2, 0, 2, 9]}
    ]},
    {"sequence": [
      {"op": "task_create", "args": [5, 50], "expect": [5, 50, 0, 0]},
      {"op": "task_submit", "args": ["$_"], "error": "StateError"}
    ]},
    {"sequence": [
      {"op": "task_create", "args": [5, 50], "expect": [5, 50, 0, 0]},
      {"op": "accept_task", "args": ["$_", 3], "expect": [5, 50, 1, 3]},
      {"op": "task_submit", "args": ["$_"], "expect": [5, 50, 2, 3]},
      {"op": "task_accept", "args": ["$_", 5], "expect": [5, 50, 3, 3]}
    ]},
    {"sequence": [
      {"op": "task_create", "args": [2, 0], "expect": [2, 0, 0, 0]},
      {"op": "accept_task", "args": ["$_", 9], "expect": [2, 0, 1, 9]},
      {"op": "task_submit", "args": ["$_"], "expect": [2, 0, 2, 9]},
      {"op": "task_accept", "args": ["$_", 2], "expect": [2, 0, 3, 9]}
    ]},
    {"sequence": [
      {"op": "task_create", "args": [5, 50], "expect": [5, 50, 0, 0]},
      {"op": "accept_task", "args": ["$_", 3], "expect": [5, 50, 1, 3]},
      {"op": "task_submit", "args": ["$_"], "expect": [5, 50, 2, 3]},
      {"op": "task_accept", "args": ["$_", 9], "error": "AuthError"}
    ]},
    {"sequence": [
      {"op": "task_create", "args": [5, 50], "expect": [5, 50, 0, 0]},
      {"op": "task_accept", "args": ["$_", 5], "error": "StateError"}
    ]},
    {"op": "review_merge", "args": [[[1, 1, 3], [2, 1, 2]]], "expect": 1},
    {"op": "review_merge", "args": [[[1, 0, 5], [2, 1, 2]]], "expect": 0},
    {"op": "review_merge", "args": [3], "error": "TypeError"},
    {"op": "contribution_score", "args": [[[1, 1, 3], [2, 2, 4]]], "expect": 7},
    {"op": "contribution_score", "args": [[[1, 1, -5], [2, 2, 3]]], "expect": 0},
    {"op": "contribution_score", "args": [5], "error": "TypeError"},
    {"op": "credit_score", "args": [[]], "expect": 100},
    {"op": "credit_score", "args": [[[0, 1]]], "expect": 105},
    {"op": "credit_score", "args": [[[1, 1]]], "expect": 70},
    {"op": "credit_score", "args": [[[1, 1], [0, 1]]], "expect": 75},
    {"op": "credit_score", "args": [[[1, 2]]], "expect": 49},
    {"op": "credit_score", "args": [5], "error": "TypeError"}
  ]
}
